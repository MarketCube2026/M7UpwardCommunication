{
  "name": "zhibi-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:push": "tsx prisma/init.ts",
    "db:seed": "tsx prisma/seed.ts",
    "cf:d1:local": "npx wrangler d1 execute zhibi --local --file=workers/api/schema.sql",
    "cf:d1:remote": "npx wrangler d1 execute zhibi --remote --file=workers/api/schema.sql",
    "cf:deploy:api": "npx wrangler deploy",
    "cf:deploy:pages": "npx wrangler pages deploy out --project-name zhibi",
    "db:migrate": "prisma db push",
    "db:seed:dev": "tsx prisma/commercial-seed.ts",
    "db:init:commercial": "tsx prisma/commercial-init.ts",
    "prepare:beta-prisma": "node scripts/prepare-beta-prisma.mjs",
    "db:push:beta": "npm run prepare:beta-prisma && prisma db push --schema .beta-prisma/schema.prisma",
    "db:seed:beta": "npm run prepare:beta-prisma && prisma generate --schema .beta-prisma/schema.prisma && tsx prisma/commercial-seed.ts",
    "vercel-build": "npm run prepare:beta-prisma && prisma generate --schema .beta-prisma/schema.prisma && prisma db push --schema .beta-prisma/schema.prisma && next build",
    "test:commercial": "tsx tests/commercial-smoke.ts",
    "test:beta": "tsx tests/beta-smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@serwist/next": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.468.0",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "serwist": "^9.0.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "dotenv": "^16.6.1",
    "prisma": "^6.14.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.127.1"
  }
}
